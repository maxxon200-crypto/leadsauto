# Optional environment overrides for leadsauto.
# Copy to `.env` and adjust. (Loading .env is left to your shell/tooling;
# the CLI reads most settings from flags.)

# Custom User-Agent for outbound requests.
LEADSAUTO_USER_AGENT="leadsauto/0.1 (+https://github.com/maxxon200-crypto/leadsauto)"

# Default minimum delay (seconds) between requests to the same host.
LEADSAUTO_MIN_DELAY=1.0
